# ---------------------------------------------------------------------------
# PhD Research Studio — environment
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# Neon Postgres connection string. Dashboard → your project → Connect →
# "Node.js" / "Serverless driver". It looks like:
#   postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Public base URL of this app. Used for the OpenRouter referer header.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# openrouter | perplexity | openai
# `openrouter` is the recommended default: one key gives you Perplexity Sonar
# (grounded web search), Gemini, DeepSeek and more, so you can mix a cheap
# grounded model with a stronger reasoning model.
AI_PROVIDER=openrouter

OPENROUTER_API_KEY=

# Only needed when AI_PROVIDER=perplexity (or as a fallback for the research tier).
PERPLEXITY_API_KEY=

# Only needed when AI_PROVIDER=openai.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Models per tier (comma separated, first match wins; the first model that
# answers is used). Cost-conscious defaults are shown — quality/cost knobs.
# ---------------------------------------------------------------------------

# Grounded tier: built-in web search, used for literature questions.
# Cheap and grounded: perplexity/sonar.  Deeper: perplexity/sonar-pro
# (substantially more expensive), perplexity/sonar-reasoning.
AI_MODEL_RESEARCH=perplexity/sonar

# Reasoning tier: article extraction, taxonomy fill, drafting, synthesis.
# Cost-conscious: google/gemini-2.5-flash.  Stronger: deepseek/deepseek-chat-v3.1,
# qwen/qwen3-235b-a22b-2507, anthropic/claude-3.5-haiku.
AI_MODEL_REASONING=google/gemini-2.5-flash

# Fast tier: cheap repair and formatting work.
AI_MODEL_FAST=google/gemini-2.5-flash-lite

# Appended to every tier's list as a last resort before giving up.
AI_FALLBACK_MODELS=deepseek/deepseek-chat-v3.1
