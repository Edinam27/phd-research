# ---------------------------------------------------------------------------
# Kadi Research Studio — environment
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# Neon Postgres connection string. Dashboard → your project → Connect →
# "Node.js" / "Serverless driver". It looks like:
#   postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Public base URL of this app. Used for the OpenRouter referer header and OAuth redirects.
# Leave BLANK anywhere this app is hosted (Vercel, any other host): the origin is
# then derived per request, so redirects always go to the deployment the user is
# on. Set it only when running locally, and only if the port is not 3111.
APP_URL=

# ---------------------------------------------------------------------------
# Administrators
# ---------------------------------------------------------------------------
# Comma-separated. Any account on this list sees the /admin control room: every
# user and every workspace in the studio, read-only. It is the bootstrap — the
# first admin cannot be flagged from inside the app — and after that the same
# access can be granted per account with `update users set is_admin = true`.
# Each address is matched case-insensitively against the registered email.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# openrouter | perplexity | openai
# `openrouter` is the recommended default: one key gives you Perplexity Sonar
# (grounded web search), Gemini, DeepSeek and more, so you can mix a cheap
# grounded model with a stronger reasoning model.
AI_PROVIDER=openrouter

OPENROUTER_API_KEY=

# Only needed when AI_PROVIDER=perplexity (or as a fallback for the research tier).
PERPLEXITY_API_KEY=

# Only needed when AI_PROVIDER=openai.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Models per tier (comma separated, first match wins; the first model that
# answers is used). Cost-conscious defaults are shown — quality/cost knobs.
# ---------------------------------------------------------------------------

# Grounded tier: built-in web search, used for literature questions.
# Cheap and grounded: perplexity/sonar.  Deeper: perplexity/sonar-pro
# (substantially more expensive), perplexity/sonar-reasoning.
AI_MODEL_RESEARCH=perplexity/sonar

# Manuscript writing tier: the model that drafts every section of a paper.
# Pinned on purpose — a manuscript must read as one voice, so this does not
# fall through to another model. The `:batch` variant is the same model at half
# the price; drop the suffix for the standard endpoint. It is an OpenRouter
# model id, so it needs OPENROUTER_API_KEY.
MANUSCRIPT_MODEL=google/gemini-3.1-flash-lite:batch

# Reasoning tier: article extraction, taxonomy fill, synthesis.
# Cost-conscious: google/gemini-2.5-flash.  Stronger: deepseek/deepseek-chat-v3.1,
# qwen/qwen3-235b-a22b-2507, anthropic/claude-3.5-haiku.
AI_MODEL_REASONING=google/gemini-2.5-flash

# Fast tier: cheap repair and formatting work.
AI_MODEL_FAST=google/gemini-2.5-flash-lite

# Appended to every tier's list as a last resort before giving up.
AI_FALLBACK_MODELS=deepseek/deepseek-chat-v3.1

# ---------------------------------------------------------------------------
# Tokens and payments (Paystack)
# ---------------------------------------------------------------------------
# AI calls are charged against a prepaid token balance. One token is one model
# token, debited 1:1 after each answered call; margin is made at the pack
# level. Packs live in src/lib/tokens.ts — prices are whole cedis.
#
# Paystack keys from your dashboard (live keys are already in .env.local).
# The public key opens checkout; the secret key initialises, verifies and
# signs webhooks.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Currency the Paystack account settles in. GHS by default: pack prices are
# authored in dollars and converted to their cedi equivalent at checkout
# using GHS_PER_USD. Set USD only if the account genuinely settles in dollars.
PAYSTACK_CURRENCY=GHS

# Webhook endpoint to configure in the Paystack dashboard:
#   https://<your-domain>/api/paystack/webhook
#
# Free tokens credited when an account is created.
STARTER_GRANT_TOKENS=100000

# Minimum confirmed balance before a model call is allowed.
# MIN_BALANCE_TOKENS=200

# Cedis per US dollar. Converts the dollar pack prices to their cedi charge
# at Paystack checkout, and converts model cost back to cedis on the admin
# profitability panel. Tune it to the current rate.
GHS_PER_USD=11.78

# ---------------------------------------------------------------------------
# Google OAuth (for seamless Google sign-in)
# ---------------------------------------------------------------------------
# Create credentials in Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
# e.g. https://your-app.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Free-tier Gemini (optional, spent first)
# ---------------------------------------------------------------------------
# A direct Google AI Studio key. When present, reasoning and fast tier calls
# run on Gemini's free daily quota first and only fall through to the paid
# provider when the quota is exhausted or the key is absent. The grounded
# research tier stays on the paid provider first so literature claims keep
# their built-in web-search citations.
#
# Defaults target the flash-lite tier, which answers reliably on the
# OpenAI-compatible endpoint; Google's 3.x flash generation stalls under
# load. As models settle, pin faster ones with:
#   GEMINI_MODEL_REASONING=gemini-3.8-flash
#   GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Set to false when the Gemini key moves to a paid plan, so list prices are
# recorded in the cost ledger and the profitability panel stays honest.
GEMINI_FREE_TIER=true
# Hard ceiling per model attempt in ms — a hung model moves the chain on.
# AI_REQUEST_TIMEOUT_MS=180000
